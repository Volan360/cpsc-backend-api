              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"WITHDRAWAL\",\n  \"amount\": 200.00,\n  \"description\": \"Updated description for transaction\",\n  \"tags\": [\"updated\", \"expense\"],\n  \"transactionDate\": 1735041600\n}"
